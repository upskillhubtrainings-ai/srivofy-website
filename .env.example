# Srivofy website — environment variables
#
# This site is a static export and needs NO secrets to build.
# All public settings (contact details, social links, demo URLs, feature flags)
# live in src/config/site.ts — edit that file instead.
#
# The contact form's recipient email is configured server-side in
# public/api/contact-config.php (never in frontend code).
#
# Optional: override the canonical site URL for a staging build.
# NEXT_PUBLIC_SITE_URL=https://www.srivofy.com
